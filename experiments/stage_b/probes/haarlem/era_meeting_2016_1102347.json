Z;Het besluit heeft geen financi&euml;le consequenties;Het college mandateert het afdelingshoofd Omgevingsvergunning het besluit te ondertekenen en administratief af te handelen;Verzoeker ontvangt zo spoedig mogelijk na besluitvorming schriftelijk informatie over dit besluit.</p>"}]}, "agenda_items": [], "module_items": [], "id": 7533773, "type": "agenda_point", "order": 4, "start_offset": null, "end_offset": null, "start_date": null, "end_date": null, "confidential": 0, "permission_group": "public", "last_modified": "2023-04-24 10:52:58", "documents": [{"self": "api.notubiz.nl/document/12616777", "url": "https://api.notubiz.nl/document/12616777/1", "title": "1. Raadsinformatieformulier", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12616777, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-12 14:01:42", "version": 1, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "1_ Raadsinformatieformulier.pdf", "file_size": 435704, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12616777/1/connections/1/7533773", "version": 1, "order": 1, "document_id": 12616777, "connection_type": 1, "connection_id": 7533773}]}, {"self": "api.notubiz.nl/document/12616778", "url": "https://api.notubiz.nl/document/12616778/2", "title": "2. Collegebesluit: afwijzen verzoek om vergoeding planschade Amsterdamsevaart 288", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12616778, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-21 15:11:58", "version": 2, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "2_ Collegebesluit_ afwijzen verzoek om vergoeding planschade Amsterdamsevaart 288.pdf", "file_size": 426693, "id": 2}, {"type": "file", "mime_type": "application/pdf", "file_name": "2_ Collegebeslu