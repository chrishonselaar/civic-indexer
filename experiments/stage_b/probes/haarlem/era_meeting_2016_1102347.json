2616821", "url": "https://api.notubiz.nl/document/12616821/2", "title": "5. Bijlage: Wijzigingsoverzicht bp IJsbaan", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12616821, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-21 15:12:53", "version": 2, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "5_ Bijlage_ Wijzigingsoverzicht bp IJsbaan.pdf", "file_size": 319479, "id": 2}, {"type": "file", "mime_type": "application/pdf", "file_name": "5_ Bijlage_ Wijzigingsoverzicht bp IJsbaan.pdf", "file_size": 319479, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12616821/2/connections/1/7533784", "version": 2, "order": 5, "document_id": 12616821, "connection_type": 1, "connection_id": 7533784}]}]}, {"parent": null, "meeting": {"id": 1102347, "self": "api.notubiz.nl/events/meetings/1102347"}, "type_data": {"self": "api.notubiz.nl/agenda_items/agenda_points/7533785", "heading": false, "title_prefix": "9.", "attributes": [{"id": 1, "reference_model": null, "preview": false, "value": "Bouwleges: terugbetaling bij bestemmingsplannen ouder dan tien jaar"}, {"id": 3, "reference_model": null, "preview": false, "value": "<p>1. Het college besluit met onmiddellijke ingang geen leges te heffen voor aanvragen waarop artikel 3.1, vierde lid, Wro van toepassing is (zie hiervoor het overzicht in bijlage A);2. Het college besluit om voor alle gevallen waarop artikel 3.1, vierde lid, Wro van toepassing is en waarvoor tussen 1 juli 2013 en heden wel leges is betaald, de reeds betaalde leges terug te betalen aan de aanvrager onder de voorwaarden zoals opgenomen in bijlage B (beleidsprogramma 6.3);3. Het college besluit om voor alle gevallen waarop artikel 3.1, vierde lid, Wro niet van toepassing is en waar in afwachting van het nu voorliggende collegebesluit nog geen leges is geheven, alsnog de leges in rekening te brengen;4. De lasten van dit besluit bedragen &euro; 58133,21 . De lasten worden betaald uit de te ontvangen baten leges Wabo 2015. 5. Het college stuurt bijgevoegd besluit ter informatie naar de commissies Bestuur</p>"}]}, "agenda_items": [], "module_items": [], "id": 7533785, "type": "agenda_point", "order": 9, "start_offset": null, "end_offset": null, "start_date": null, "end_date": null, "confidential": 0, "permission_group": "public", "last_modified": "2023-04-21 15:13:05", "documents": [{"self": "api.notubiz.nl/document/12616865", "url": "https://api.notubiz.nl/document/12616865/1", "title": "1. Raadsinformatieformulier", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12616865, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-12 14:06:06", "version": 1, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "1_ Raadsinformatieformulier.pdf", "file_size": 441702, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12616865/1/connections/1/7533785", "version": 1, "order": 1, "document_id": 12616865, "connection_type": 1, "connection_id": 7533785}]}, {"self": "api.notubiz.nl/document/12616867", "url": "https://api.notubiz.nl/document/12616867/2", "title": "2. Bouwleges: terugbetaling bij bestemmingsplannen ouder dan tien jaar", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12616867, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-21 15:13:05", "version": 2, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "2_ Bouwleges_ terugbetaling bij bestemmingsplannen ouder dan tien jaar.pdf", "file_size": 531974, "id": 2}, {"type": "file", "mime_type": "application/pdf", "file_name": "2_ Bouwleges_ terugbetaling bij bestemmingsplannen ouder dan tien jaar.pdf", "file_size": 531974, "id": 1}], "conn