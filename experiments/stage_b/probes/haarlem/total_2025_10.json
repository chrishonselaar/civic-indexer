{"status": 200, "body": {"pagination": {"next": "organisation_id=544&format=json&version=1.21.1&date_from=2025-10-01+00%3A00%3A00&date_to=2025-11-01+00%3A00%3A00&page=2&per_page=1", "previous": "", "page": 1, "per_page": 1, "total_pages": 18, "items_on_page": 1, "total_items": 18, "has_more_pages": true}, "events": [{"organisation": {"id": 544, "self": "api.notubiz.nl/organisations/544"}, "gremium": {"id": 525, "self": "api.notubiz.nl/organisations/544/gremia/525"}, "event_type_data": {"self": "api.notubiz.nl/events/meetings/1297467", "agenda_item_count": 0, "document_count": 0}, "id": 1297467, "self": "api.notubiz.nl/events/1297467", "type": "meeting", "permission_group": "public", "body": "council", "confidential": 0, "announcement": true, "canceled": false, "inactive": false, "creation_date": "2024-11-08 12:57:09", "last_modified": "2025-07-07 16:41:02", "order": null, "live": false, "archive_state": "unarchived", "archive_state_last_modified": null, "allow_subscriptions": false, "subscriptions": [], "attributes": [{"id": 1, "reference_model": null, "value": "Met de raad in Zuidwest"}, {"id": 50, "reference_model": null, "value": "Stadsdeel Zuidwest, Pelgrimkerk, Stephensonstraat 1, Haarlem"}, {"id": 72, "reference_model": null, "value": "Heske Pohlmann-Vonk & Lisette Verbeem"}, {"id": 3, "reference_model": null, "value": "<p class=\"informative-articles\" style=\"border: 0px; color: #222222; font-family: Poppins, sans-serif; font-size: 16px; background-color: #ffffff;\"><span style=\"border: 0px; font-weight: 600;\">Wat doet de Haarlemse gemeenteraad? Wie zijn onze raadsleden en wat kunnen zij voor u betekenen? Hoe kunt u invloed kunt uitoefenen op beslissingen in de stad? Dit is uw kans!</span></p>\r\n<p class=\"informative-articles\" style=\"border: 0px; color: #222222; font-family: Poppins, sans-serif; font-size: 16px; background-color: #ffffff;\">Om daar antwoorden op te geven bezoekt de raad elk stadsdeel. <strong>Ontmoet</strong> <span style=\"border: 0px; font-weight: 600;\">de Raad in de Stad </span>is<span style=\"border: 0px;\"> een laagdrempelige en informele bijeenkomst, waarbij u in gesprek kunt met de Haarlemse gemeenteraadsleden. </span><span style=\"border: 0px;\">Zij ontmoeten u graag om te horen wat er leeft binnen uw wijk.</span><span style=\"border: 0px;\"> Dit keer is Zuidwest aan de beurt.</span></p>"}], "plannings": [{"start_date": "2025-10-01 19:00:00", "end_date": "2025-10-01 22:00:00"}]}]}}