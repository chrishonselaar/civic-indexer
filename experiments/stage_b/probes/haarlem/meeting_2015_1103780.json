atie per 1 januari 2015.pdf", "file_size": 31748, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12635036/1/connections/1/7543776", "version": 1, "order": 3, "document_id": 12635036, "connection_type": 1, "connection_id": 7543776}]}, {"self": "api.notubiz.nl/document/12635038", "url": "https://api.notubiz.nl/document/12635038/1", "title": "6. Bijlage D: Mandaatbesluit samenwerking Zandvoort-Haarlem sociaal domein", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12635038, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-17 11:04:44", "version": 1, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "2014436873 6_ Bijlage D_ Mandaatbesluit samenwerking Zandvoort-Haarlem sociaal domein.pdf", "file_size": 269001, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12635038/1/connections/1/7543776", "version": 1, "order": 4, "document_id": 12635038, "connection_type": 1, "connection_id": 7543776}]}, {"self": "api.notubiz.nl/document/12635039", "url": "https://api.notubiz.nl/document/12635039/1", "title": "7. Bijlage E: Bewerkersovereenkomst samenwerking Zandvoort-Haarlem sociaal domein", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12635039, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-04-17 11:04:44", "version": 1, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "2014436873 7_ Bijlage E_ Bewerkersovereenkomst samenwerking Zandvoort-Haarlem sociaal domein.pdf", "file_size": 309171, "id": 1}], "connections": [{"self": "https://api.notubiz.nl/document/12635039/1/connections/1/7543776", "version": 1, "order": 5, "document_id": 12635039, "connection_type": 1, "connection_id": 7543776}]}]}]}}}