tings/1096242"}, "type_data": {"self": "api.notubiz.nl/agenda_items/agenda_points/7491502", "heading": false, "title_prefix": "8.", "attributes": [{"id": 1, "reference_model": null, "preview": false, "value": "Opleggen geheimhouding taxatierapporten en toelichting Badmintonpad, verkoop kavel"}, {"id": 3, "reference_model": null, "preview": false, "value": "<p>1. De taxatierapporten van Adhoc en Van der Weerd voor het Badmintonpad ten behoeve van de Bisonbowling en een toelichting ter beschikking te stellen aan de commissie Ontwikkeling (bijlage 1, 2 en 3). 2. Op de bij dit besluit behorende taxatierapporten en toelichting (bijlage 1, 2 en 3) geheimhouding op te leggen aan de commissie Ontwikkeling op grond van artikel 86, tweede lid van de Gemeentewet, vanwege de bescherming van de economische of financi&euml;le belangen van de gemeente en het voorkomen van onevenredige bevoordeling of benadeling van bij de aangelegenheid betrokken natuurlijke personen of rechtspersonen dan wel van derden, als bedoeld in artikel 10, tweede lid, aanhef en onder b en g van de Wet openbaarheid van bestuur.</p>"}]}, "agenda_items": [], "module_items": [], "id": 7491502, "type": "agenda_point", "order": 8, "start_offset": null, "end_offset": null, "start_date": null, "end_date": null, "confidential": 0, "permission_group": "public", "last_modified": "2023-05-22 10:16:04", "documents": [{"self": "api.notubiz.nl/document/12548047", "url": "https://api.notubiz.nl/document/12548047/1", "title": "1. Opleggen geheimhouding taxatierapporten en toelichting Badmintonpad, verkoop kavel\r\n", "description": "", "date": "", "case_code": "", "policy_field": "", "category": "", "id": 12548047, "confidential": 0, "publication_date": "2026-07-23", "last_modified": "2023-03-24 09:24:19", "version": 1, "types": [{"id": 1, "value": "Document"}], "versions": [{"type": "file", "mime_type": "application/pdf", "file_name": "20200198634 1_ Opleggen geheimhouding taxatierapporten en toelichting Badmintonpad, ver