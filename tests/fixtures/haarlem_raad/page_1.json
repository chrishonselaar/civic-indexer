      "attributes": [
        {
          "id": 1,
          "reference_model": null,
          "value": "Cursus \"Hoe werkt de gemeenteraad?'"
        },
        {
          "id": 50,
          "reference_model": null,
          "value": "Enschedekamer"
        },
        {
          "id": 3,
          "reference_model": null,
          "value": "<p><span style=\"font-size: 11pt; line-height: 110%; font-family: Calibri, sans-serif;\">Ter afsluiting van de cursus &lsquo;Hoe werkt de gemeenteraad?&rsquo; voor inwoners van Haarlem gaan deelnemers dieper in op de rollen, taken en instrumenten van de gemeenteraad. De besluitvorming, begroting en de manier waarop zij invloed kunnen uitoefenen komen ook aan bod.</span></p>"
        }
      ],
