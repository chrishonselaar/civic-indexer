      "attributes": [
        {
          "id": 1,
          "reference_model": null,
          "value": "Commissie samenleving"
        },
        {
          "id": 50,
          "reference_model": null,
          "value": "Enschedekamer"
        },
        {
          "id": 72,
          "reference_model": null,
          "value": "dhr. E. Aerssens"
        },
        {
          "id": 3,
          "reference_model": null,
          "value": "<p class=\"MsoNormal\">Bij deze vergadering is ondertiteling beschikbaar. U kunt deze aanzetten door in de balk onderaan de videoplayer op \"CC\" te klikken.</p><p class=\"MsoNormal\"><a href=\"../../info/Nieuws_en_Informatie/132\">Inspreken</a> bij de geagendeerde onderwerpen ter advisering en bespreking is mogelijk op het stadhuis of schriftelijk. U dient zich hiervoor <a href=\"../../formulieren/inspreken\">aan te melden</a>. Dit kan tot <span style=\"text-decoration: underline;\">uiterlijk 24 uur</span> voor aanvang van de vergadering.</p><p class=\"MsoNormal\"><a href=\"../../info/Nieuws_en_Informatie/132/Inspreken\">Inspreken</a> op onderwerpen die <u>niet</u> op de agenda staan, kunt u doen voorafgaand aan een raadsvergadering bij het 'Inspreekuur burgers over niet geagendeerde onderwerpen' van 18:15 tot 19:15 uur. U dient zich uiterlijk 24 uur voor aanvang van het inspreekuur aan te melden om in spreken.</p><p class=\"MsoNormal\">Wanneer u een niet-geagendeerd onderwerp alleen schriftelijk onder de aandacht van de commissie- of raadsleden wilt brengen, kunt u op elk moment een <a href=\"../../info/nieuws_en_informatie/133/brief_e_mail_aan_de_gemeenteraad\">brief of e-mail </a>aan de raad sturen (<a href=\"mailto:griffiebureau@haarlem.nl\">griffiebureau@haarlem.nl</a>).&lt;/p  <p class=\"MsoNormal\">NB. Onderstaande aanvangstijden van de agendapunten zijn indicatief.</p>"
        }
      ],
      "plannings": [
        {
          "start_date": "2026-06-04 20:20:00",
